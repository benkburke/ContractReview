{
  "openapi": "3.1.1",
  "info": {
    "title": "ContractReview API",
    "description": "HTTP API for ContractReview.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/contracts": {
      "post": {
        "tags": [
          "Contracts"
        ],
        "operationId": "UploadContract",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadContractForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "URL of the created resource.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Contracts"
        ],
        "operationId": "ListContracts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContractSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/{id}": {
      "get": {
        "tags": [
          "Contracts"
        ],
        "operationId": "GetContract",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/{id}/index": {
      "post": {
        "tags": [
          "Contracts"
        ],
        "operationId": "IndexContract",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/{id}/claims": {
      "post": {
        "tags": [
          "Contracts"
        ],
        "operationId": "EvaluateClaim",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-SignalR-Connection-Id",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "description": "URL of the created resource.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimEvaluationDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Contracts"
        ],
        "operationId": "ListClaims",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimHistoryPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/contracts/{id}/claims/{claimId}": {
      "get": {
        "tags": [
          "Contracts"
        ],
        "operationId": "GetClaim",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "claimId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimEvaluationDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClaimCitationDto": {
        "required": [
          "sectionHeading",
          "excerpt"
        ],
        "type": "object",
        "properties": {
          "sectionHeading": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      },
      "ClaimEvaluationDto": {
        "required": [
          "id",
          "contractId",
          "claimText",
          "coverageLevelRequested",
          "state",
          "createdAtUtc",
          "result",
          "errorCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contractId": {
            "type": "string",
            "format": "uuid"
          },
          "claimText": {
            "type": "string"
          },
          "coverageLevelRequested": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/ClaimState"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ClaimEvaluationResultDto"
              }
            ]
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "review": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ClaimReviewDto"
              }
            ]
          }
        }
      },
      "ClaimEvaluationResultDto": {
        "required": [
          "status",
          "confidence",
          "coverageLevel",
          "needsCoverageLevel",
          "coverageLevelOptions",
          "coveredItems",
          "excludedItems",
          "reasoning",
          "followUpQuestion",
          "citations",
          "model"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "coverageLevel": {
            "type": [
              "null",
              "string"
            ]
          },
          "needsCoverageLevel": {
            "type": "boolean"
          },
          "coverageLevelOptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coveredItems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludedItems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasoning": {
            "type": "string"
          },
          "followUpQuestion": {
            "type": [
              "null",
              "string"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimCitationDto"
            }
          },
          "model": {
            "type": "string"
          }
        }
      },
      "ClaimHistoryPageDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimSummaryDto"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ClaimReviewDto": {
        "required": [
          "state",
          "agreesWithPrimary",
          "isCovered",
          "confidence",
          "accuracyExplanation",
          "coveredItems",
          "notCoveredItems",
          "model",
          "errorCode"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/ClaimReviewState"
          },
          "agreesWithPrimary": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "isCovered": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "accuracyExplanation": {
            "type": [
              "null",
              "string"
            ]
          },
          "coveredItems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notCoveredItems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ClaimReviewState": {
        "enum": [
          "Completed",
          "Failed"
        ]
      },
      "ClaimState": {
        "enum": [
          "Evaluated",
          "Failed"
        ]
      },
      "ClaimStatus": {
        "enum": [
          "Covered",
          "NotCovered",
          "Conditional",
          "InsufficientInformation"
        ]
      },
      "ClaimSummaryDto": {
        "required": [
          "id",
          "claimText",
          "state",
          "status",
          "confidence",
          "reviewAgrees",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claimText": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ClaimState"
          },
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ClaimStatus"
              }
            ]
          },
          "confidence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reviewAgrees": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContractDetailDto": {
        "required": [
          "id",
          "title",
          "fileName",
          "sizeBytes",
          "pageCount",
          "uploadedAtUtc",
          "extractedText",
          "indexStatus",
          "sections"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "pageCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "uploadedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "extractedText": {
            "type": "string"
          },
          "indexStatus": {
            "$ref": "#/components/schemas/IndexStatus"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContractSectionDto"
            }
          }
        }
      },
      "ContractSectionDto": {
        "required": [
          "order",
          "heading",
          "chunkCount"
        ],
        "type": "object",
        "properties": {
          "order": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "heading": {
            "type": "string"
          },
          "chunkCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ContractSummaryDto": {
        "required": [
          "id",
          "title",
          "fileName",
          "sizeBytes",
          "pageCount",
          "uploadedAtUtc",
          "indexStatus"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "pageCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "uploadedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "indexStatus": {
            "$ref": "#/components/schemas/IndexStatus"
          }
        }
      },
      "EvaluateClaimRequest": {
        "required": [
          "claimText"
        ],
        "type": "object",
        "properties": {
          "claimText": {
            "type": "string"
          },
          "coverageLevel": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "IndexStatus": {
        "enum": [
          "NotIndexed",
          "Indexing",
          "Indexed",
          "Failed"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UploadContractForm": {
        "required": [
          "title",
          "file"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "file": {
            "$ref": "#/components/schemas/IFormFile"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Contracts"
    }
  ]
}