{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "coordinator",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Agent(backend)",
      "Agent(frontend)",
      "Agent(tester)",
      "Agent(documentor)",
      "Agent(scout)",
      "Bash(dotnet *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(sqllocaldb *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:mui.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.nuget.org)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(dotnet ef database update*)",
      "Bash(dotnet ef migrations remove*)",
      "Bash(dotnet nuget push *)",
      "Bash(npm publish *)",
      "Edit(./.github/workflows/**)"
    ],
    "deny": [
      "Agent(fork)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/appsettings.*.local.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/status.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.mjs\""
          }
        ]
      }
    ]
  }
}
